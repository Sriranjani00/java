class Solution {
    public boolean isMatch(String s, String p) {
        int sIdx = 0, pIdx = 0, lastWildcardIdx = -1, sNextIdx = -1;

        while (sIdx < s.length()) {
            // 1. If characters match or pattern has '?'
            if (pIdx < p.length() && (p.charAt(pIdx) == '?' || p.charAt(pIdx) == s.charAt(sIdx))) {
                sIdx++;
                pIdx++;
            } 
            // 2. If pattern has '*', record position and try matching 0 characters first
            else if (pIdx < p.length() && p.charAt(pIdx) == '*') {
                lastWildcardIdx = pIdx;
                sNextIdx = sIdx;
                pIdx++;
            } 
            // 3. If no match, but we saw a '*' earlier, backtrack:
            // Match one more character from 's' with that '*'
            else if (lastWildcardIdx != -1) {
                pIdx = lastWildcardIdx + 1;
                sNextIdx++;
                sIdx = sNextIdx;
            } 
            // 4. No match and no '*' to backtrack to
            else {
                return false;
            }
        }

        // Check for remaining characters in pattern (only '*' can remain)
        while (pIdx < p.length() && p.charAt(pIdx) == '*') {
            pIdx++;
        }

        return pIdx == p.length();
    }
}
