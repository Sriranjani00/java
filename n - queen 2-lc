class Solution {
    private int count = 0;

    public int totalNQueens(int n) {
        // Trackers for columns and the two types of diagonals
        boolean[] cols = new boolean[n];
        boolean[] diag1 = new boolean[2 * n]; // r + c
        boolean[] diag2 = new boolean[2 * n]; // r - c (offset to avoid negative)

        backtrack(0, n, cols, diag1, diag2);
        return count;
    }

    private void backtrack(int row, int n, boolean[] cols, boolean[] diag1, boolean[] diag2) {
        // Base case: All queens placed
        if (row == n) {
            count++;
            return;
        }

        for (int col = 0; col < n; col++) {
            int d1 = row + col;
            int d2 = row - col + n;

            // If the position is safe
            if (!cols[col] && !diag1[d1] && !diag2[d2]) {
                // Place Queen (set flags)
                cols[col] = diag1[d1] = diag2[d2] = true;

                backtrack(row + 1, n, cols, diag1, diag2);

                // Backtrack (unset flags)
                cols[col] = diag1[d1] = diag2[d2] = false;
            }
        }
    }
}
