class Solution {
    public String countAndSay(int n) {
        if (n <= 0) return "";
        String res = "1";
        
        // Iterate from 1 up to n-1 to build the sequence
        for (int i = 1; i < n; i++) {
            res = getNext(res);
        }
        
        return res;
    }

    private String getNext(String s) {
        StringBuilder sb = new StringBuilder();
        int i = 0;
        
        while (i < s.length()) {
            int count = 1;
            char digit = s.charAt(i);
            
            // Count consecutive identical characters
            while (i + 1 < s.length() && s.charAt(i + 1) == digit) {
                count++;
                i++;
            }
            
            // Append the count followed by the digit itself
            sb.append(count).append(digit);
            i++;
        }
        
        return sb.toString();
    }
}
